<?xml version="1.0" encoding="utf-8"?>
<!-- v1.5.0 高级苹果：弹窗按 iOS sheet 惯例自底部滑入（450ms sheet 曲线无法在 XML 表达，用 decelerate 近似；窗口动画只能走资源） -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/decelerate_interpolator">
    <translate android:fromYDelta="12%" android:toYDelta="0" android:duration="280"/>
    <alpha android:fromAlpha="0.0" android:toAlpha="1.0" android:duration="280"/>
</set>
