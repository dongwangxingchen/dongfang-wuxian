<?xml version="1.0" encoding="utf-8"?>
<!--
  [DFW-74] 打开诚信付费页时**旧页**（设置页 / MainActivity）的退场：
  原地退回并压暗 —— 与站内子页转场 MainActivity.animatePage 的"推入"分支里 previous 完全一致：
    previous.animate().scaleX(0.94f).scaleY(0.94f).alpha(0.55f).setDuration(300).setInterpolator(emphasized)
  且 pivot 取自身中心（站内 previous.setPivotX/Y(width/2, height/2)），所以这里是 50%/50%。
  层级语义：下面那一页**永远不透明地待在原地**，只是"退回去 + 被压暗"，不是淡出消失。
  系统"动画时长缩放 = 0"时窗口动画被系统整体跳过，不需要额外门控。
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
     android:shareInterpolator="false"
     android:interpolator="@android:interpolator/fast_out_slow_in">
    <scale
        android:fromXScale="1.0"
        android:toXScale="0.94"
        android:fromYScale="1.0"
        android:toYScale="0.94"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="300" />
    <alpha
        android:fromAlpha="1.0"
        android:toAlpha="0.55"
        android:duration="300" />
</set>
